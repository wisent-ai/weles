{
  "description": "The Weles services whose credentials are read with their own scoped Skarbiec consumer: each service's consumer, the vault role its item plays (reads ask for role:<item>, the local credentials file keys fields by it), the schema of the fields its credential holds, and, for a service Weles writes, the Skarbiec kind its item is stored as. The TypeScript runtime and the trajectories both read this one catalog.",
  "schemas": {
    "login": { "username": true, "password": true },
    "login_with_totp": { "username": true, "password": true, "totp_secret": true },
    "api_key": { "api_key": true },
    "basic_proxy": { "username": true, "password": true },
    "endpoint_proxy": { "username": true, "password": true, "host": true, "ports": true },
    "zoned_proxy": { "username": true, "password": true, "zone": true },
    "browser_endpoint": { "websocket_url": true },
    "app_store_connect_key": { "key_id": true, "issuer_id": true, "private_key": true },
    "signing_key": { "key_id": true, "private_key": true }
  },
  "services": {
    "googleSso": {
      "consumer": "weles-google-sso-client",
      "item": "weles-google-sso-login",
      "schema": "login"
    },
    "googleAds": {
      "consumer": "weles-google-ads-client",
      "item": "weles-google-ads-login",
      "schema": "login_with_totp",
      "kind": "login"
    },
    "gmail": {
