{
  "product": "weles-worker",
  "policy": {
    "service": "weles-admission",
    "config_schema": 1,
    "state_schema": 1,
    "install_root": "/Users/charles/.stado/services/com.wisent.always-on.weles-api",
    "binary": "payload/weles-worker.tar.gz",
    "launcher": "weles-api-launcher",
    "binary_env": "WELES_WORKER_ARCHIVE",
    "port_env": "WELES_API_PORT",
    "runtime_env": "WELES_REPO",
    "readiness_path": "/healthz",
    "environment": {
      "WELES_WORKER_ENV_FILE": "{home}/.config/weles/worker.env"
    },
    "signing_key_item": "",
    "signing_key_id": "",
    "strategy": {
      "kind": "replace",
      "readiness_timeout_seconds": 90,
      "drain_timeout_seconds": 15,
      "rollback_window_seconds": 300,
      "automatic_rollback": true
    },
    "targets": {
      "charless-mac-mini": {
        "platform": "darwin-arm64",
        "run_as_user": "charles",
        "home": "/Users/charles",
        "state_dir": "/Users/charles/.stado/release-state",
        "runtime_root": "/Users/charles/.stado/run",
        "logs_root": "/Users/charles/.stado/logs",
        "legacy_launchd_label": "com.wisent.always-on.weles-api",
        "legacy_launchd_plist": "/Library/LaunchDaemons/com.wisent.always-on.weles-api.plist"
      }
    },
    "desired": null,
    "previous": null
  }
}
