#!/bin/bash
set -euo pipefail

standby_marker="${HOME}/.stado/files/weles-admission-standby"
marker_state=""
if [ -r "${standby_marker}" ]; then
  IFS= read -r marker_state < "${standby_marker}" || true
fi
if [ "${marker_state}" = "standby" ]; then
  exec /bin/sleep 604800
fi

exec /bin/bash "${HOME}/weles/scripts/worker/deploy/launch-weles-api-mac.sh"
