{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weles.wisent.com/schemas/deployment-manifest.v2.json",
  "title": "Weles immutable Stado deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "deploymentId",
    "createdAt",
    "sourceRevision",
    "worker",
    "web",
    "database",
    "client",
    "browsers",
    "compatibility"
  ],
  "properties": {
    "schema": { "const": "weles.deployment.v2" },
    "deploymentId": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "sourceRevision": { "$ref": "#/$defs/gitSha" },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sourceRevision", "artifacts"],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "sourceRevision": { "$ref": "#/$defs/gitSha" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deploymentId", "sourceRevision", "apiSchemas"],
      "properties": {
        "deploymentId": { "type": "string", "minLength": 1 },
        "sourceRevision": { "$ref": "#/$defs/gitSha" },
        "apiSchemas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/apiSchema" }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "migrationSetSha256"],
      "properties": {
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "migrationSetSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumVersion", "apiSchemas"],
      "properties": {
        "minimumVersion": { "$ref": "#/$defs/semver" },
        "apiSchemas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/apiSchema" }
        }
      }
    },
    "browsers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chromium", "firefox"],
      "properties": {
        "chromium": { "$ref": "#/$defs/browserRelease" },
        "firefox": { "$ref": "#/$defs/browserRelease" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workerDatabase", "webDatabase"],
      "properties": {
        "workerDatabase": { "$ref": "#/$defs/versionRange" },
        "webDatabase": { "$ref": "#/$defs/versionRange" }
      }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "apiSchema": { "type": "string", "pattern": "^weles\\.[a-z0-9-]+\\.v[1-9][0-9]*$" },
    "platform": { "type": "string", "enum": ["darwin-arm64", "darwin-amd64", "linux-amd64"] },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "uri", "sha256", "entrypoint"],
      "properties": {
        "platform": { "$ref": "#/$defs/platform" },
        "uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^stado://releases/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/[a-z0-9-]+/[A-Za-z0-9._-]+$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "entrypoint": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$", "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" } }
      }
    },
    "browserRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "sourceRevision", "capabilitiesSha256", "artifacts"],
      "properties": {
        "release": { "type": "string", "minLength": 1 },
        "sourceRevision": { "$ref": "#/$defs/gitSha" },
        "capabilitiesSha256": { "$ref": "#/$defs/sha256" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "versionRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "type": "integer", "minimum": 1 },
        "maximum": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
