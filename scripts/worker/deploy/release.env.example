# Required nonsecret immutable release coordinates. Deployment owns the values.
STADO_RELEASE_API_URL=
WELES_WORKER_RELEASE_VERSION=
WELES_WORKER_RELEASE_SHA256=
WELES_CHROMIUM_RELEASE_VERSION=
WELES_CHROMIUM_RELEASE_SHA256=
WELES_FIREFOX_RELEASE_VERSION=
WELES_FIREFOX_RELEASE_SHA256=

# Skarbiec acquisition scopes are tracked separately in
# skarbiec-acquisition-scopes.conf using consumer|item|field exact-name rows.
# The private signing key is the workload identity; only its nonsecret path and
# stable workload id belong in this env.
SKARBIEC_WORKLOAD_ID=
SKARBIEC_WORKLOAD_SIGNING_KEY_FILE=

# Optional install roots; leave unset to use the per-user immutable stores.
# WELES_WORKER_RELEASE_ROOT=
# WELES_CURRENT_LINK=
# WELES_CHROMIUM_DIR=
# WELES_FIREFOX_DIR=
