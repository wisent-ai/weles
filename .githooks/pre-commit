#!/bin/sh
set -eu

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  exit 0
fi

# Block accidental Supabase CLI invocations from being committed.
# Remote DDL and project management must be intentional, never buried in scripts.
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"
  if [ -n "$staged_files" ]; then
    matches="$(printf '%s' "$staged_files" | xargs -I{} git show :{} 2>/dev/null | grep -nE 'supabase[[:space:]]+(db|link|login|logout|projects|start|stop|status|migration|inspect|gen|types|sso|orgs|secrets|functions|storage|realtime|vectors|db|dump|pull|push|reset|lint|diff|test|bench|seed|snapshots|branches|completion|help)' || true)"
    if [ -n "$matches" ]; then
      printf '%s\n' "pre-commit blocked: staged files contain Supabase CLI usage."
      printf '%s\n' "Remote database operations must be run intentionally, never committed as scripts."
      printf '%s\n' "Matches:"
      printf '%s\n' "$matches"
      exit 1
    fi
  fi
fi

# Static guardrail for staged scripts: browser tasks must use Weles through the
# Weles API on the Mac mini, not local Playwright/Chrome launches. Existing
# legacy/debug launchers are being migrated separately; this hook blocks new or
# modified staged violations without freezing unrelated commits on the baseline.
# Runtime/eval cells are outside git-hook scope and need a harness-level block.
if [ -f scripts/lint/check_browser_boundary.mjs ]; then
  staged_browser_files="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\\.(mjs|js|cjs|ts|tsx)$' || true)"
  if [ -n "$staged_browser_files" ]; then
    node scripts/lint/check_browser_boundary.mjs $staged_browser_files
  fi
fi

# The three version documents agree in what is about to be committed: a bump
# of package.json without release/version-change.json's candidate, or a
# baseline without its current, is refused here instead of in the version gate.
staged_version_files="$(git diff --cached --name-only --diff-filter=ACMR -- released-surface.json release/version-change.json package.json)"
if [ -n "$staged_version_files" ]; then
  version_disagreements="$(node scripts/release/version/disagreements.mjs --index)"
  if [ -n "$version_disagreements" ]; then
    printf '%s\n' "pre-commit blocked: the staged version documents disagree:"
    printf '%s\n' "$version_disagreements"
    printf '%s\n' "Run the steps docs/versions.md lists (adopt-published, npm version, declare-candidate) and stage their documents."
    exit 1
  fi
fi

# A trajectory never calls process.exit: it ends Node before the finally that
# closes the session, so a failed run loses its network log, final dump and
# video. A failure throws, or sets process.exitCode and returns.
staged_trajectories="$(git diff --cached --name-only --diff-filter=ACMR -- 'src/trajectories/*.mjs' 'src/trajectories/*.js' 'src/trajectories/*.ts')"
if [ -n "$staged_trajectories" ]; then
  exits="$(printf '%s\n' "$staged_trajectories" | while IFS= read -r file; do git show ":$file" | grep -n 'process\.exit(' | sed "s|^|$file:|"; done)"
  if [ -n "$exits" ]; then
    printf '%s\n' "pre-commit blocked: staged trajectories call process.exit, which skips the finally that closes the session:"
    printf '%s\n' "$exits"
    printf '%s\n' "Throw the failure, or set process.exitCode and return."
    exit 1
  fi
fi
