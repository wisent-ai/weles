{
  "name": "weles",
  "version": "0.5.73",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "weles": "dist/cli.js",
    "weles-mcp": "dist/mcp.js"
  },
  "scripts": {
    "build": "tsc && cp src/page-init/*.js dist/page-init/ && mkdir -p dist/page-init/firefox && cp src/page-init/firefox/*.js dist/page-init/firefox/ && mkdir -p dist/release && cp src/release/*.mjs dist/release/ && mkdir -p dist/figma && cp src/figma/export-design-assets.mjs src/figma/parse-figma-document.py dist/figma/ && mkdir -p dist/diagnostics && (cp -f src/diagnostics/*.js dist/diagnostics/ 2>/dev/null || true)",
    "test": "tap tests/**/*.test.ts && node --test tests/worker/*.test.mjs tests/release/*.test.mjs",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "@wisent-ai/weles-client": "github:wisent-ai/weles-client#37798a26022a040fbd0a4a4a25c99b5559d95a32",
    "@wisent/cost-tracker": "github:wisent-ai/wisent-cost-tracker#5c07c0287beaeafec828ad2744baf6239f3ff0e1",
    "cloakbrowser": "^0.3.24",
    "fingerprint-generator": "^2.1.0",
    "header-generator": "^2.1.0",
    "jsqr": "^1.4.0",
    "node-pty": "^1.1.0",
    "patchright": "^1.59.4",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/tap": "^18.0.0",
    "@types/ws": "^8.5.0",
    "tap": "^18.0.0",
    "typescript": "^5.7.0"
  }
}
