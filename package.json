{
  "name": "weles",
  "version": "0.5.4",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "weles": "dist/cli.js",
    "weles-mcp": "dist/mcp.js"
  },
  "scripts": {
    "build": "tsc && cp src/scripts/*.js dist/scripts/ && mkdir -p dist/scripts/firefox && cp src/scripts/firefox/*.js dist/scripts/firefox/ && mkdir -p dist/diagnostics && (cp -f src/diagnostics/*.js dist/diagnostics/ 2>/dev/null || true)",
    "postinstall": "node scripts/postinstall/playwright_scrub.mjs",
    "lint-trust": "node scripts/lint/check_trust.mjs",
    "lint-humanization": "node scripts/lint/check_humanization.mjs",
    "lint-browser-boundary": "node scripts/lint/check_browser_boundary.mjs",
    "lint": "npm run lint-trust && npm run lint-humanization && npm run lint-modules",
    "lint-modules": "node scripts/lint/check_module_load.mjs",
    "diag:run-request": "node scripts/diag/run_diagnostic_request.mjs",
    "dev": "tsc --watch",
    "secrets:acquire": "node scripts/secrets/acquire.mjs"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "@wisent-ai/weles-client": "github:wisent-ai/weles-client#ed2f99c51395c0ab80e36dc873a63716a10315e7",
    "@wisent/cost-tracker": "github:wisent-ai/wisent-cost-tracker#5c07c0287beaeafec828ad2744baf6239f3ff0e1",
    "cloakbrowser": "^0.3.24",
    "fingerprint-generator": "^2.1.0",
    "header-generator": "^2.1.0",
    "jsqr": "^1.4.0",
    "node-pty": "^1.1.0",
    "patchright": "^1.59.4",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0",
    "postgres": "^3.4.9",
    "sharp": "^0.34.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0"
  }
}
