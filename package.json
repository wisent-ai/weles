{
  "name": "weles",
  "version": "0.8.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "imports": {
    "#run-output": "./src/_shared/run-output/index.mjs",
    "#operator-request": "./src/operator/request.mjs",
    "#ncbr-settings": "./src/trajectories/ncbr/settings/index.mjs",
    "#ncbr-cookie-notice": "./src/trajectories/_shared/ncbr/cookie_notice.mjs"
  },
  "bin": {
    "weles": "dist/cli.js",
    "weles-mcp": "dist/mcp.js"
  },
  "scripts": {
    "prepare": "npm run build",
    "preversion": "node scripts/release/rollback-compat.mjs",
    "version": "git add .wisent-release.json",
    "build": "tsc && rsync -a --prune-empty-dirs --include='*/' --include='*.js' --include='*.mjs' --include='*.cjs' --exclude='*' src/ dist/ && chmod u+x,go+x dist/cli.js dist/mcp.js",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "@wisent-ai/weles-client": "github:wisent-ai/weles-client#b33f2e6dc6efbef6c721c973d04ce3cda8a2a74e",
    "@wisent/cost-tracker": "github:wisent-ai/wisent-cost-tracker#5c07c0287beaeafec828ad2744baf6239f3ff0e1",
    "@wisent/errors": "https://codeload.github.com/wisent-ai/wisent-errors/tar.gz/48b951d024b37972e53e60f98c2582e2f65fb92a",
    "cloakbrowser": "^0.3.24",
    "fingerprint-generator": "^2.1.0",
    "header-generator": "^2.1.0",
    "jsqr": "^1.4.0",
    "node-pty": "^1.1.0",
    "patchright": "^1.59.4",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0"
  }
}
